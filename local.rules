# =====================================================================
# TASK 4 - Network Intrusion Detection System
# Custom Local Rules for Suricata
# File: local.rules  (loaded via suricata.yaml -> rule-files)
# =====================================================================
# Rule syntax: action proto src_ip src_port -> dst_ip dst_port (options)
# sid range 1000001-1000030 reserved for this project (avoid clashing
# with the official Emerging Threats / ET-OPEN ruleset).
# =====================================================================

# ---------------------------------------------------------------
# 1. RECONNAISSANCE / PORT SCANNING
# ---------------------------------------------------------------

# Detect classic Nmap TCP SYN / connect scan (many SYNs, no data)
alert tcp any any -> $HOME_NET any (msg:"NIDS - Possible Nmap TCP Scan Detected"; \
    flags:S; threshold:type both, track by_src, count 20, seconds 10; \
    classtype:attempted-recon; sid:1000001; rev:2;)

# Detect Nmap OS-fingerprint / NULL scan
alert tcp any any -> $HOME_NET any (msg:"NIDS - NULL Scan Detected"; \
    flags:0; threshold:type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; sid:1000002; rev:1;)

# Detect Nmap XMAS scan
alert tcp any any -> $HOME_NET any (msg:"NIDS - XMAS Scan Detected"; \
    flags:FPU; threshold:type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; sid:1000003; rev:1;)

# Detect UDP port sweep
alert udp any any -> $HOME_NET any (msg:"NIDS - UDP Port Sweep Detected"; \
    threshold:type both, track by_src, count 25, seconds 10; \
    classtype:attempted-recon; sid:1000004; rev:1;)

# ---------------------------------------------------------------
# 2. BRUTE-FORCE / AUTHENTICATION ATTACKS
# ---------------------------------------------------------------

# SSH brute force (many connection attempts to port 22 from same host)
alert tcp any any -> $HOME_NET 22 (msg:"NIDS - Possible SSH Brute Force Attack"; \
    flags:S; threshold:type both, track by_src, count 5, seconds 60; \
    classtype:attempted-admin; sid:1000005; rev:2;)

# FTP brute force
alert tcp any any -> $HOME_NET 21 (msg:"NIDS - Possible FTP Brute Force Attack"; \
    content:"530 Login incorrect"; threshold:type both, track by_src, count 5, seconds 60; \
    classtype:attempted-admin; sid:1000006; rev:1;)

# RDP brute force
alert tcp any any -> $HOME_NET 3389 (msg:"NIDS - Possible RDP Brute Force Attack"; \
    flags:S; threshold:type both, track by_src, count 5, seconds 60; \
    classtype:attempted-admin; sid:1000007; rev:1;)

# ---------------------------------------------------------------
# 3. WEB APPLICATION ATTACKS
# ---------------------------------------------------------------

# Basic SQL Injection attempt in HTTP request
alert http any any -> $HOME_NET any (msg:"NIDS - SQL Injection Attempt Detected"; \
    flow:to_server,established; \
    pcre:"/(\%27)|(\')|(\-\-)|(\%23)|(#)/i"; \
    classtype:web-application-attack; sid:1000008; rev:2;)

alert http any any -> $HOME_NET any (msg:"NIDS - SQLi UNION SELECT Detected"; \
    flow:to_server,established; content:"union"; nocase; content:"select"; nocase; distance:0; \
    classtype:web-application-attack; sid:1000009; rev:1;)

# Basic Cross-Site Scripting (XSS) attempt
alert http any any -> $HOME_NET any (msg:"NIDS - XSS Attempt Detected"; \
    flow:to_server,established; content:"<script"; nocase; \
    classtype:web-application-attack; sid:1000010; rev:1;)

# Directory traversal attempt
alert http any any -> $HOME_NET any (msg:"NIDS - Directory Traversal Attempt"; \
    flow:to_server,established; content:"../../"; \
    classtype:web-application-attack; sid:1000011; rev:1;)

# Suspicious User-Agent (common scanner tools)
alert http any any -> $HOME_NET any (msg:"NIDS - Scanner Tool User-Agent Detected (sqlmap/nikto/nmap)"; \
    flow:to_server,established; content:"User-Agent|3a| "; http_header; \
    pcre:"/User-Agent\x3a\s*(sqlmap|nikto|nmap|acunetix)/i"; \
    classtype:attempted-recon; sid:1000012; rev:1;)

# ---------------------------------------------------------------
# 4. DENIAL OF SERVICE / FLOODING
# ---------------------------------------------------------------

# ICMP flood (ping flood)
alert icmp any any -> $HOME_NET any (msg:"NIDS - Possible ICMP Flood (Ping Flood)"; \
    itype:8; threshold:type both, track by_src, count 50, seconds 10; \
    classtype:attempted-dos; sid:1000013; rev:1;)

# SYN flood
alert tcp any any -> $HOME_NET any (msg:"NIDS - Possible TCP SYN Flood"; \
    flags:S; threshold:type both, track by_dst, count 100, seconds 5; \
    classtype:attempted-dos; sid:1000014; rev:1;)

# ---------------------------------------------------------------
# 5. MALWARE / COMMAND-AND-CONTROL INDICATORS
# ---------------------------------------------------------------

# Outbound connection to a known-bad/high-risk port often used by C2 (example, tune to threat intel)
alert tcp $HOME_NET any -> any 4444 (msg:"NIDS - Possible Metasploit/C2 Reverse Shell Port"; \
    flags:S; classtype:trojan-activity; sid:1000015; rev:1;)

# DNS query with unusually long domain name (possible DNS tunneling)
alert dns any any -> any any (msg:"NIDS - Possible DNS Tunneling (long query name)"; \
    dns.query; pcre:"/^.{60,}$/"; \
    classtype:bad-unknown; sid:1000016; rev:1;)

# Executable downloaded over plain HTTP
alert http any any -> $HOME_NET any (msg:"NIDS - Executable File Download over HTTP"; \
    flow:from_server,established; file_data; content:"MZ"; startswith; \
    classtype:trojan-activity; sid:1000017; rev:1;)

# ---------------------------------------------------------------
# 6. POLICY / INTERNAL MISUSE
# ---------------------------------------------------------------

# Telnet usage (insecure protocol) - policy violation
alert tcp any any -> $HOME_NET 23 (msg:"NIDS - Telnet Protocol Usage Detected (Insecure)"; \
    flags:S; classtype:policy-violation; sid:1000018; rev:1;)

# =====================================================================
# END OF RULESET
# =====================================================================
